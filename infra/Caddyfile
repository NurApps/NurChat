# NurChat public relay — Caddy with automatic HTTPS.
# Set DOMAIN env (or replace {$DOMAIN}) pointing to this host.
{
	admin off
}

{$DOMAIN:relay.nurchat.app} {
	# Single block: Caddy upgrades websockets transparently, no separate
	# @ws matcher needed (a second unconditional reverse_proxy would shadow
	# it anyway — only the first handler ever fires).
	reverse_proxy nurchat:8000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
	}
}
