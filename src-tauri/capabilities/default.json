{
  "identifier": "default",
  "description": "Default capability set for NurChat",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": false
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": false
    }
  ]
}
