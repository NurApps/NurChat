{
  "identifier": "default",
  "description": "Default capability set for NurChat",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "notification:default",
    "updater:default",
    "process:default"
  ]
}
