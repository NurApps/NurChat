```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Federation signing keys (auto-generated, NEVER commit)
federation_keys.json

# IDE specific
.vscode/
.idea/

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-selfcheck.json
.pytest_cache/
.mypy_cache/
.coverage
coverage/

# Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z

# Fonts
AppleColorEmoji.ttf

# Compiled files
*.exe
*.dll
*.so
*.a
*.obj
*.out
*.class
*.jar
*.war
*.ear

# Coverage reports
coverage/
htmlcov/

# Distribution / packaging
*.egg-info/
.eggs/
eggs/
parts/
develop-eggs/
.installed.cfg
lib/
lib64/
```