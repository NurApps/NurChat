# Server (relay)
# ⚠️ Relay разворачивается ОДИН раз (например, через docker-compose up -d).
# Пользователям не нужно запускать собственный сервер — приложение подключается
# к общему relay по адресу VITE_API_HOST.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True

# CORS — белый список (важно для relay, к нему подключаются десктоп-клиенты Tauri)
# Дефолт уже включает tauri://localhost и https://tauri.localhost.
# CORS_ORIGINS=https://relay.example.com,https://tauri.localhost

# Database
# Десктоп (SQLite, zero-config):
DATABASE_URL=sqlite:///./nurchat.db
# Docker/production (PostgreSQL):
# DATABASE_URL=postgresql://nurchat:nurchat_pass@localhost:5432/nurchat

# Redis (presence, online status, кэш)
# Для Docker: redis://redis:6379/0
# Для десктопа: не требуется (отключить явно, чтобы не логировать ошибку подключения)
# REDIS_URL=redis://localhost:6379/0
# USE_REDIS=true  # true — Redis обязателен (при недоступности лог ERROR + degraded); false — отключён явно

# ⚠️ Encryption — CRITICAL: MUST set stable keys before starting!
# Server will NOT start without these keys. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
JWT_SECRET_KEY=

# ⚠️ TOTP 2FA Master Key — MUST set for 2FA support
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOTP_MASTER_KEY=

# WebRTC ICE Servers (STUN/TURN)
# For calls to work behind NAT, configure a TURN server:
# WEBRTC_ICE_SERVERS=[{"urls":"turn:your-turn-server.com:3478","username":"user","credential":"pass"}]
# Default STUN servers from Google are used if not set.

# P2P (experimental)
USE_P2P=False

# Frontend (Vite) — адрес relay, к которому подключается приложение
VITE_API_HOST=localhost:8000
