{
  "title": "NurChat",
  "uid": "nurchat",
  "panels": [
    {
      "title": "HTTP Requests",
      "type": "graph",
      "targets": [{ "expr": "rate(nurchat_http_requests_total[5m])", "legendFormat": "{{method}} {{endpoint}}" }]
    },
    {
      "title": "Request Duration",
      "type": "graph",
      "targets": [{ "expr": "rate(nurchat_http_request_duration_seconds_sum[5m])", "legendFormat": "{{endpoint}}" }]
    },
    {
      "title": "Active WebSocket Connections",
      "type": "stat",
      "targets": [{ "expr": "nurchat_ws_active_connections" }]
    }
  ]
}
