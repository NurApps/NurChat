# NurChat — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False

# --- CORS ---
# Comma-separated origins. Desktop app uses tauri://localhost.
# CORS_ORIGINS=https://relay.example.com,https://tauri.localhost

# --- Database ---
# Desktop (zero-config SQLite):
DATABASE_URL=sqlite:///./nurchat.db
# Docker/production self-hosted Postgres:
# DATABASE_URL=postgresql://nurchat:PASSWORD@db:5432/nurchat
# Free managed Postgres (Supabase, no expiry — see DEPLOY.md $0-static):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres
# (URL-encode special chars in password. Pool is capped in code for free tiers.)

# ⚠️ Encryption — CRITICAL: Set stable keys here!
# If ENCRYPTION_KEY or JWT_SECRET_KEY are empty, they auto-generate on each restart,
# making ALL encrypted data (messages, files) permanently inaccessible.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
JWT_SECRET_KEY=

# ⚠️ TOTP 2FA Master Key — CRITICAL: Set a stable key for TOTP secret encryption
# This key is used to encrypt TOTP secrets in the database.
# If changed, all existing TOTP configurations will become invalid.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOTP_MASTER_KEY=

# WebRTC ICE Servers (STUN/TURN)
# For calls to work behind NAT, configure a TURN server:
# WEBRTC_ICE_SERVERS=[{"urls":"turn:your-turn-server.com:3478","username":"user","credential":"pass"}]
# Default STUN servers from Google are used if not set.
# WEBRTC_ICE_SERVERS=

# --- PostgreSQL credentials (used by docker-compose) ---
POSTGRES_USER=nurchat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nurchat

# --- Redis ---
# Docker:
# REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
# Desktop (disabled):
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Deaf relay (conductor, not storage: delete rows after delivery) ---
RELAY_DEAF=true
MESSAGE_RETENTION_HOURS=48

# --- WebRTC ---
# STUN servers (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN server (required for calls behind NAT).
# Must match infra/coturn.conf credentials:
# WEBRTC_ICE_SERVERS=[{"urls":"turn:your-turn.com:3478","username":"user","credential":"pass"}]
TURN_USERNAME=nurchat
TURN_CREDENTIAL=CHANGE_ME_IN_PRODUCTION

# Federation (server-to-server)
# USE_FEDERATION=True
# FEDERATION_SERVER_NAME=your-server.com:8000

# Frontend (Vite)
VITE_API_HOST=localhost:8000

# --- Frontend (Vite) ---
# Leave empty to auto-detect public relay at startup.
# Set only if you run your own relay and want to skip probing.
# VITE_API_HOST=localhost:8000
