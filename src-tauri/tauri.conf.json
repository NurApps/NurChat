{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NurChat",
  "version": "0.16.0",
  "identifier": "com.nurapps.nurchat",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "NurChat",
        "visible": false,
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: http://localhost:5173 http://localhost:8000 http://127.0.0.1:8000 ws://localhost:5173 ws://localhost:8000 ws://127.0.0.1:8000 https://api.qrserver.com; img-src 'self' data: blob: https: http: ws:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; media-src 'self' blob: data: https: http:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5REY4QUQ4OERBRUM1N0IKUldSN3hhNk4ySXJmK2JiTWtYT0hzaVpPNTFRY09HSnRVditBTS8zKzFzR2k2eTlBdzF1aENidU0K",
      "endpoints": [
        "https://github.com/NurApps/NurChat_desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/server"
    ],
    "resources": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
